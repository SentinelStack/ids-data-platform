<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Kotlin emits synthetic members and null-checks that SpotBugs (a Java
         bytecode analyzer) misreads; suppress those well-known false positives. -->
    <Match>
        <Bug pattern="NP_NONNULL_PARAM_VIOLATION"/>
    </Match>
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
